import json

def load_json_data(filename):
    with open(filename,"r") as file:
        data = json.load(file)
    return data

def user_data(data): 
    print("Users Connections and Updated Data: ")
    for user in data["users"]:
       print(f"{user['name']} having the friendship with the friends {user['friends']}")



data_dic = load_json_data("data.json")


user_data(data_dic)



